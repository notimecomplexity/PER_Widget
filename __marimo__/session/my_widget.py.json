          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">This is a \"clock\" element \u2014 it doesn't display anything meaningful itself, but it changes its internal value on a timer (every 0.1 seconds here). Since marimo cells rerun whenever a variable they depend on changes, any cell that references refresh will get re-triggered every 100ms \u2014 this is what drives the \"live\" redrawing, since otherwise the chart cell would only rerun when its own inputs (like the dropdown) change, not when new background data arrives.</span></span>"
          }
        }
      ],
      "console": []
    },
